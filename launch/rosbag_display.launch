<launch>
  <arg name="model" default="mevius2_livox" />
  <param name="robot_description" textfile="$(find mevius2)/models/$(arg model).urdf" />
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find mevius2)/config/mevius2_display_livox.rviz" />
</launch>
